# Generate a unique random value before exposing the API beyond localhost.
PROPERTY_PULSE_SECRET=replace-with-a-long-random-secret
PROPERTY_PULSE_TOKEN_HOURS=168
PROPERTY_PULSE_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional storage overrides. Defaults stay inside backend/.
